<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<TestTfmsInParallel>false</TestTfmsInParallel>
		<StartupObject>Zongsoft.Messaging.ZeroMQ.Tests.TestProgram</StartupObject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.v3.core" />
		<PackageReference Include="xunit.v3.assert" />
		<PackageReference Include="xunit.analyzers" />
		<PackageReference Include="xunit.v3.runner.msbuild" />
		<PackageReference Include="xunit.runner.visualstudio" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.ObjectPool" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Zongsoft.Core">
			<HintPath>..\..\..\Zongsoft.Core\src\bin\$(Configuration)\$(TargetFramework)\Zongsoft.Core.dll</HintPath>
		</Reference>
		<Reference Include="Zongsoft.Plugins">
			<HintPath>..\..\..\Zongsoft.Plugins\src\bin\$(Configuration)\$(TargetFramework)\Zongsoft.Plugins.dll</HintPath>
		</Reference>

		<ProjectReference Include="..\src\Zongsoft.Messaging.ZeroMQ.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\Zongsoft.Plugins\plugins\Main.plugin" Link="Fixtures\Main.plugin" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\src\*.plugin" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\src\*.option" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
