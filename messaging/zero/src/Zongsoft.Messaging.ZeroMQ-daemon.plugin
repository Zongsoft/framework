<?xml version="1.0" encoding="utf-8" ?>

<plugin name="Zongsoft.Messaging.ZeroMQ.Daemon"
        title="Zongsoft.Messaging.ZeroMQ.Daemon Plugin"
        author="Zongsoft Studio(zongsoft@qq.com)"
        copyright="Copyright(C) Zongsoft Studio. 2015-2026. All rights reserved."
        description="Created Date: 2026-08-10 by Popeye Zhong" >

	<manifest>
		<assemblies>
			<assembly name="Zongsoft.Messaging.ZeroMQ" />
		</assemblies>

		<dependencies>
			<dependency name="Zongsoft.Messaging.ZeroMQ"/>
		</dependencies>
	</manifest>

	<extension path="/Workbench/Messaging/Zero">
		<object name="QueueServer" type="Zongsoft.Messaging.ZeroMQ.ZeroQueueServer, Zongsoft.Messaging.ZeroMQ"
		        Enabled="{option:/Messaging/ZeroMQ/Server/Enabled}"
		        Storage="{option:/Messaging/ZeroMQ/Server/Storage}"
		        Control="{option:/Messaging/ZeroMQ/Server/Control}"
		        Incoming="{option:/Messaging/ZeroMQ/Server/Incoming}"
		        Outgoing="{option:/Messaging/ZeroMQ/Server/Outgoing}"
		        Discovery="{option:/Messaging/ZeroMQ/Server/Discovery}">
			<object.constructor>
				<parameter name="name" value="{option:/Messaging/ZeroMQ/Server/Name}" />
			</object.constructor>

			<expose name="Storages" value="{path:../@Storages}" />
		</object>
	</extension>

	<extension path="/Workbench/Startup">
		<object value="{path:/Workbench/Messaging/Zero/QueueServer}" />
	</extension>
</plugin>
