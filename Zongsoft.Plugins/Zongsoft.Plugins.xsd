<?xml version="1.0" encoding="utf-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    elementFormDefault="qualified"
    attributeFormDefault="unqualified">
	<xs:element name="plugin" nillable="false">
		<xs:annotation>
			<xs:documentation xml:lang="zh">根节点，表示插件元素。</xs:documentation>
		</xs:annotation>

		<xs:complexType>
			<xs:sequence>
				<xs:element name="manifest" type="ManifestElementType" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="zh">有关插件定义的清单。可以省略，最多出现一次，且必须位于基础声明和扩展元素之前。</xs:documentation>
					</xs:annotation>
				</xs:element>

				<xs:group ref="FoundationGroup" />

				<xs:element name="extension" type="ExtensionElementType" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation xml:lang="zh">表示构件的挂载扩展点。</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>

			<xs:attribute name="name" type="xs:string" use="required">
				<xs:annotation>
					<xs:documentation xml:lang="zh">插件名称，在依赖中需要指定该名称。</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="title" type="xs:string">
				<xs:annotation>
					<xs:documentation xml:lang="zh">插件标题。</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="author" type="xs:string">
				<xs:annotation>
					<xs:documentation xml:lang="zh">作者信息。</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="version">
				<xs:annotation>
					<xs:documentation xml:lang="zh">插件版本。</xs:documentation>
				</xs:annotation>

				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="[0-9]+\.[0-9]+(\.[0-9]+)?(\.[0-9]+)?" />
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="copyright" type="xs:string">
				<xs:annotation>
					<xs:documentation xml:lang="zh">版权信息。</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="description" type="xs:string">
				<xs:annotation>
					<xs:documentation xml:lang="zh">插件详细描述。</xs:documentation>
				</xs:annotation>
			</xs:attribute>

			<xs:anyAttribute processContents="skip" />
		</xs:complexType>

		<xs:key name="builderKey">
			<xs:selector xpath="builders/builder" />
			<xs:field xpath="@name" />
		</xs:key>
		<xs:key name="parserKey">
			<xs:selector xpath="parsers/parser" />
			<xs:field xpath="@name" />
		</xs:key>
	</xs:element>

	<xs:complexType name="ManifestElementType">
		<xs:all>
			<xs:element name="assemblies" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="zh">插件对应的程序集列表。</xs:documentation>
				</xs:annotation>

				<xs:complexType>
					<xs:sequence>
						<xs:element name="assembly" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation xml:lang="zh">插件程序集名称，有关程序集名请参考System.Assembly的说明。</xs:documentation>
							</xs:annotation>

							<xs:complexType>
								<xs:attribute name="name" type="xs:string" use="required">
									<xs:annotation>
										<xs:documentation xml:lang="zh">插件程序集名称。</xs:documentation>
									</xs:annotation>
								</xs:attribute>
								<xs:attribute name="optional" type="xs:boolean" use="optional">
									<xs:annotation>
										<xs:documentation xml:lang="zh">指定程序集是否为可选项。</xs:documentation>
									</xs:annotation>
								</xs:attribute>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>

			<xs:element name="dependencies" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="zh">当前插件依赖的插件列表。</xs:documentation>
				</xs:annotation>

				<xs:complexType>
					<xs:sequence>
						<xs:element name="dependency" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation xml:lang="zh">当前插件的依赖插件名。</xs:documentation>
							</xs:annotation>

							<xs:complexType>
								<xs:attribute name="name" type="xs:string" use="required">
									<xs:annotation>
										<xs:documentation xml:lang="zh">依赖的插件名。注：此名称不是插件的文件名。</xs:documentation>
									</xs:annotation>
								</xs:attribute>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:all>
	</xs:complexType>

	<xs:group name="FoundationGroup">
		<xs:sequence>
			<xs:element name="builders" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="zh">表示构建器的定义集。</xs:documentation>
				</xs:annotation>

				<xs:complexType>
					<xs:sequence>
						<xs:element name="builder" type="NameTypeElement" minOccurs="1" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation xml:lang="zh">要进行注册的构建器定义。</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>

			<xs:element name="parsers" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="zh">表示解析器的定义集。</xs:documentation>
				</xs:annotation>

				<xs:complexType>
					<xs:sequence>
						<xs:element name="parser" type="NameTypeElement" minOccurs="1" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation xml:lang="zh">要进行注册的解析器定义。</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:group>

	<xs:complexType name="ExtensionElementType">
		<xs:sequence>
			<xs:any minOccurs="0" maxOccurs="unbounded" namespace="##any" processContents="lax" />
		</xs:sequence>

		<xs:attribute name="path" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation xml:lang="zh">表示挂载的扩展点位置。</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:element name="object" type="BuiltinElementType">
		<xs:annotation>
			<xs:documentation xml:lang="zh">创建或引用对象，并装配其子构件。</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:element name="expose" type="BuiltinElementType">
		<xs:annotation>
			<xs:documentation xml:lang="zh">暴露对象或属性，装配其子构件，但不向所有者追加自身。</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:complexType name="BuiltinElementType">
		<xs:annotation>
			<xs:documentation xml:lang="zh">子元素可以是构件、构造声明、行为或“构件名.成员”扩展。已声明元素继续校验；动态名称由插件加载器和构建器解释。</xs:documentation>
		</xs:annotation>

		<xs:sequence>
			<xs:any minOccurs="0" maxOccurs="unbounded" namespace="##any" processContents="lax" />
		</xs:sequence>

		<xs:attribute name="name" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation xml:lang="zh">构件名称，与挂载路径及上级构件名称组合成完整路径。省略时生成匿名构件名称。</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="type" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation xml:lang="zh">构件类型的完整限定名，可包含程序集名称。</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="value" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation xml:lang="zh">构件的值，可以为字面量或插件解析器表达式。</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="position" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation xml:lang="zh">构件相对于兄弟节点的排列位置。</xs:documentation>
			</xs:annotation>
		</xs:attribute>

		<xs:anyAttribute processContents="skip" />
	</xs:complexType>

	<xs:element name="object.constructor" type="ConstructorElementType" />
	<xs:element name="expose.constructor" type="ConstructorElementType" />

	<xs:complexType name="ConstructorElementType">
		<xs:annotation>
			<xs:documentation xml:lang="zh">显式构造参数按声明顺序保存。所属构件必须指定 type，此上下文约束由插件加载器检查。</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="parameter" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation xml:lang="zh">参数通过名称或类型匹配；文本内容覆盖 value 属性。具体构造函数的匹配由构建器检查。</xs:documentation>
				</xs:annotation>
				<xs:complexType mixed="true">
					<xs:attribute name="name" type="xs:string" use="optional" />
					<xs:attribute name="type" type="xs:string" use="optional" />
					<xs:attribute name="value" type="xs:string" use="optional" />
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:element name="object.property" type="PropertyBehaviorElementType" />
	<xs:element name="expose.property" type="PropertyBehaviorElementType" />

	<xs:complexType name="PropertyBehaviorElementType" mixed="true">
		<xs:annotation>
			<xs:documentation xml:lang="zh">构件完成装配时，将 value 写入 target 对象的 name 成员。行为可以包含文本及扩展属性，不能包含子元素。</xs:documentation>
		</xs:annotation>
		<xs:attribute name="name" type="xs:string" use="optional" />
		<xs:attribute name="target" type="xs:string" use="optional" />
		<xs:attribute name="value" type="xs:string" use="optional" />
		<xs:anyAttribute processContents="skip" />
	</xs:complexType>

	<xs:complexType name="NameTypeElement">
		<xs:attribute name="name" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation xml:lang="zh">名称。</xs:documentation>
			</xs:annotation>
		</xs:attribute>

		<xs:attribute name="type" type="xs:string" use="required">
			<xs:annotation>
				<xs:documentation xml:lang="zh">类型的完整限定名，包括其程序集的名称，具体写法参考 System.Type 类的 AssemblyQualifiedName 属性帮助。</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
</xs:schema>
