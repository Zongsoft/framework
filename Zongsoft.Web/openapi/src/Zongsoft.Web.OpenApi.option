<?xml version="1.0" encoding="utf-8" ?>

<options>
	<option path="/web/openapi">
		<authentication persisted="true">
			<authenticator authenticator.name="credential" kind="http" scheme="Credential" />
			<authenticator authenticator.name="bearer" kind="http" scheme="Bearer" />
			<authenticator authenticator.name="basic" kind="http" scheme="Basic">
				<username>{{username}}</username>
				<password>{{password}}</password>
			</authenticator>
		</authentication>

		<headers>
			<header header.name="X-Json-Behaviors" method="GET,POST" value="ignores:null,empty;casing:camel" />
		</headers>

		<servers>
			<server server.name="current" />
			<server server.name="ports" description="Host and port" url="{scheme}://{host}:{port}">
				<variable variable.name="scheme" default="http">
					<value>http</value>
					<value>https</value>
				</variable>
				<variable variable.name="host" default="localhost" />
				<variable variable.name="port" default="8069" />
			</server>
			<server server.name="sites" description="Site, host and port" url="{scheme}://{site}.{host}:{port}">
				<variable variable.name="scheme" default="http">
					<value>http</value>
					<value>https</value>
				</variable>
				<variable variable.name="site" default="api.b">
					<value>api.a</value>
					<value>api.b</value>
					<value>api.c</value>
					<value>api.iot</value>
					<value>api.gateway</value>
				</variable>
				<variable variable.name="host" default="zongsoft.com" />
				<variable variable.name="port" default="80" />
			</server>
		</servers>

		<environments>
			<environment environment.name="production-a" url="http://api.a.zongsoft.com">
				<variable variable.name="site" default="a" />
			</environment>
			<environment environment.name="production-b" url="http://api.b.zongsoft.com">
				<variable variable.name="site" default="b" />
			</environment>
			<environment environment.name="production-c" url="http://api.c.zongsoft.com">
				<variable variable.name="site" default="c" />
			</environment>

			<environment environment.name="development-a" url="http://192.168.0.100:81">
				<variable variable.name="site" default="a" />
			</environment>
			<environment environment.name="development-b" url="http://192.168.0.100:82">
				<variable variable.name="site" default="b" />
			</environment>
			<environment environment.name="development-c" url="http://192.168.0.100:83">
				<variable variable.name="site" default="c" />
			</environment>

			<environment environment.name="staging-a" url="http://192.168.0.101:81">
				<variable variable.name="site" default="a" />
			</environment>
			<environment environment.name="staging-b" url="http://192.168.0.101:82">
				<variable variable.name="site" default="b" />
			</environment>
			<environment environment.name="staging-c" url="http://192.168.0.101:83">
				<variable variable.name="site" default="c" />
			</environment>
		</environments>
	</option>
</options>
