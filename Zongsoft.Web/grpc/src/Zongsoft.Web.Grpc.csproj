<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Version>1.4.0</Version>
		<Product>Zongsoft gRPC for Web Library</Product>
		<Description>This is a class library that provides gRPC service infrastructure.</Description>
		<RootNamespace>Zongsoft.Web.Grpc</RootNamespace>
		<IncludeSymbols>true</IncludeSymbols>
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageTags>gRPC;ASP.NET;Web;Plugin</PackageTags>
		<PackageProjectUrl>https://github.com/Zongsoft/framework</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Zongsoft/framework/tree/main/Zongsoft.Web</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Google.Protobuf" VersionOverride="3.34.0" />
		<PackageReference Include="Grpc.Reflection" VersionOverride="2.76.0" />
		<PackageReference Include="Grpc.AspNetCore.Server" VersionOverride="2.76.0" />
	</ItemGroup>

	<Choose>
		<When Condition="$(Configuration)=='Debug'">
			<ItemGroup>
				<ProjectReference Include="..\..\src\Zongsoft.Web.csproj" />
				<Reference Include="Zongsoft.Core">
					<HintPath>..\..\..\Zongsoft.Core\src\bin\$(Configuration)\$(TargetFramework)\Zongsoft.Core.dll</HintPath>
				</Reference>
			</ItemGroup>
		</When>
		<Otherwise>
			<ItemGroup>
				<PackageReference Include="Zongsoft.Core" VersionOverride="7.64.0" />
				<PackageReference Include="Zongsoft.Web" VersionOverride="7.19.0" />
			</ItemGroup>
		</Otherwise>
	</Choose>

	<ItemGroup>
		<None Include="..\README.md" Link="README.md" Pack="true" PackagePath="\" />
		<None Include="..\README.zh-Hans.md" Link="README.zh-Hans.md" Pack="true" PackagePath="\" />
		<None Include="$(MSBuildProjectName).deploy" Link=".deploy" Pack="true" PackagePath="\.deploy" />
		<None Include="$(MSBuildProjectName).plugin" Pack="true" PackagePath="\artifacts" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
</Project>
