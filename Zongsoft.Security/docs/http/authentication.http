### 身份标识登录
# @name signin
@identity = {{$input 身份标识 $value:Administrator }}
@password = {{$password 登录密码 $value: }}
POST /Security/Authentication/Signin?scenario={{scenario}} HTTP/1.1
Host: {{host}}:{{port}}

{
    "Identity":"{{identity}}",
    "Password":"{{password}}"
}

{{
	const path = require("path");
	const file = require("fs").realpathSync(__filename);
	let vscode;

	try
	{
		vscode = require("vscode");
	}
	catch(error)
	{
		if(error.code !== "MODULE_NOT_FOUND")
			throw error;
	}

	const variables = await require(path.join(path.dirname(file), "authentication.js")).saveCredential(
		response, typeof environmentName === "undefined" ? undefined : environmentName, vscode);
	$httpyac.setVariables(variables);
}}

### 验证码登录
# 注：验证码登录需要先通过 Secret 方法获取身份验证码。
# @name signin-secret
@secretToken = {{$input 令牌号 $value: }}
@secretCode = {{$input 验证码 $value: }}
POST /Security/Authentication/Signin/Secret/{{secretToken}}?scenario={{scenario}} HTTP/1.1
Host: {{host}}:{{port}}
Content-Type: text/plain

{{secretCode}}

{{
	const path = require("path");
	const file = require("fs").realpathSync(__filename);
	let vscode;

	try
	{
		vscode = require("vscode");
	}
	catch(error)
	{
		if(error.code !== "MODULE_NOT_FOUND")
			throw error;
	}

	const variables = await require(path.join(path.dirname(file), "authentication.js")).saveCredential(
		response, typeof environmentName === "undefined" ? undefined : environmentName, vscode);
	$httpyac.setVariables(variables);
}}

