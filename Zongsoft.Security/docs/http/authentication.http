# @name signin-alipay
@alipayBroker = {{$input 代理号（支付宝） $value: }}
@alipayToken = {{$input 令牌值 $value: }}
POST /Security/Authentication/Signin/Alipay/broker:{{alipayBroker}}?scenario={{scenario}} HTTP/1.1
Host: {{host}}:{{port}}
Content-Type: text/plain

{{alipayToken}}

{{
	const path = require("path");
	const file = require("fs").realpathSync(__filename);
	let vscode;

	try
	{
		vscode = require("vscode");
