<?xml version="1.0" encoding="utf-8" ?>

<options>
	<option path="/Externals/Redis">
		<connectionSettings default="local">
			<connectionSetting connectionSetting.name="local" driver="redis"
			                   value="server=127.0.0.1:6379;password=xxxxxx;timeout=5s;namespace=locator-local" />
		</connectionSettings>
	</option>
</options>
