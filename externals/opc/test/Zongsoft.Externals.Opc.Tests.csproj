<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Core" VersionOverride="2.0.1" />
		<PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Types" VersionOverride="2.0.1" />
		<PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" VersionOverride="2.0.1" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.v3.core" />
		<PackageReference Include="xunit.v3.assert" />
		<PackageReference Include="xunit.analyzers" />
		<PackageReference Include="xunit.v3.runner.msbuild" />
		<PackageReference Include="xunit.runner.visualstudio" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Zongsoft.Core">
			<HintPath>..\..\..\Zongsoft.Core\src\bin\$(Configuration)\$(TargetFramework)\Zongsoft.Core.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\src\Zongsoft.Externals.Opc.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\src\Zongsoft.Externals.Opc-daemon.plugin" Link="Zongsoft.Externals.Opc-daemon.plugin" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\src\Zongsoft.Externals.Opc-daemon.option" Link="Zongsoft.Externals.Opc-daemon.option" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
