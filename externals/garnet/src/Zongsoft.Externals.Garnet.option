<?xml version="1.0" encoding="utf-8" ?>

<?zongsoft.tools.binding name="garnet"
	path="Externals/Garnet/default"
	template="tcp://${this.Value['address']}"
	protocols="tcp"
	required="true"?>

<options>
	<option path="/Externals/Garnet">
		<server server.name="default" value="address=127.0.0.1:6379;quiet;auth=Password;password=xxxxxx;lua=true;aof=true;aof-commit-freq=1000;recover=true;checkpointdir=~/.garnet" />
	</option>
</options>
