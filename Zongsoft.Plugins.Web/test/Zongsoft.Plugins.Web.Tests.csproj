<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<StartupObject>Zongsoft.Plugins.Web.Tests.TestProgram</StartupObject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.v3.core" />
		<PackageReference Include="xunit.v3.assert" />
		<PackageReference Include="xunit.analyzers" />
		<PackageReference Include="xunit.v3.runner.msbuild" />
		<PackageReference Include="xunit.runner.visualstudio" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../src/Zongsoft.Plugins.Web.csproj" />
		<ProjectReference Include="../../Zongsoft.Plugins/src/Zongsoft.Plugins.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Zongsoft.Core">
			<HintPath>../../Zongsoft.Core/src/bin/$(Configuration)/$(TargetFramework)/Zongsoft.Core.dll</HintPath>
		</Reference>
		<Reference Include="Zongsoft.Web">
			<HintPath>../../Zongsoft.Web/src/bin/$(Configuration)/$(TargetFramework)/Zongsoft.Web.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<None Include="../../Zongsoft.Plugins/plugins/Main.plugin" Link="Fixtures/Main.plugin" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
