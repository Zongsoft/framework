		<PackageVersion Include="Microsoft.Extensions.Configuration.FileExtensions" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.FileProviders.Abstractions" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.FileProviders.Physical" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
