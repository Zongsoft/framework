<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageVersion Include="Zongsoft.Core" Version="8.0.0" />
		<PackageVersion Include="Zongsoft.Web" Version="8.0.0" />
		<PackageVersion Include="Zongsoft.Plugins" Version="8.0.0" />
		<PackageVersion Include="Zongsoft.Plugins.Web" Version="8.0.0" />
		<PackageVersion Include="Zongsoft.CodeAnalysis" Version="1.3.0" />
	</ItemGroup>
</Project>