<?xml version="1.0" encoding="utf-8" ?>

<options>
	<option path="/Diagnostics">
		<diagnostor>
			<meters>
				<filter>*</filter>

				<exporters>
					<exporter exporter.name="telemetry" driver="opentelemetry" enabled="true"
					          settings="server=http://localhost:4317/opentelemetry;protocol=grpc;processorType=batch;timeout=30s;interval=15s;" />
				</exporters>
			</meters>

			<traces>
				<filter>*</filter>

				<exporters>
					<exporter exporter.name="telemetry" driver="opentelemetry" enabled="true"
					          settings="server=http://localhost:4317/opentelemetry;protocol=grpc;processorType=batch;timeout=30s;interval=15s;" />
				</exporters>
			</traces>

			<logs includeScopes="true" includeFormattedMessage="true">
				<exporters>
					<exporter exporter.name="telemetry" driver="opentelemetry" enabled="false"
					          settings="server=http://localhost:4317/opentelemetry;protocol=grpc;processorType=batch;timeout=30s;interval=5s;" />
				</exporters>
			</logs>
		</diagnostor>
	</option>
</options>
