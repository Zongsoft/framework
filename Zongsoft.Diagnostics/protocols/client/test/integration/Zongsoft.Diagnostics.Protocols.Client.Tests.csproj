<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<OutputType>Exe</OutputType>
		<AssemblyName>Zongsoft.Diagnostics.Protocols.Client.IntegrationTests</AssemblyName>
		<RootNamespace>Zongsoft.Diagnostics.Protocols.Client.IntegrationTests</RootNamespace>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Zongsoft.Diagnostics.Protocols.Client.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server" VersionOverride="2.76.0" />
		<PackageReference Include="Grpc.Tools" VersionOverride="2.78.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.v3.core" />
		<PackageReference Include="xunit.v3.assert" />
		<PackageReference Include="xunit.analyzers" />
		<PackageReference Include="xunit.v3.runner.msbuild" />
		<PackageReference Include="xunit.runner.visualstudio" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="protos/*.proto" ProtoRoot="protos" GrpcServices="Both" />
	</ItemGroup>
</Project>
